{
  "harness-lifecycle": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python -X utf8 scripts/hook_runner.py session-start",
        "timeout": 20
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 scripts/hook_runner.py post-tool-use",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python -X utf8 scripts/hook_runner.py pre-invocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python -X utf8 scripts/hook_runner.py stop",
        "timeout": 90
      }
    ]
  }
}
